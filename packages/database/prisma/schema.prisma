datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// ─── Enums ───

enum MealCategory {
  FISK
  VEGETAR
  KYLLING
  STORFE
  ANNET
}

enum IngredientCategory {
  FRUKT_OG_GRONT
  KJOTT
  OST
  MEIERI_OG_EGG
  BROD
  BAKEVARER
  HERMETIKK
  TORRVARER
  HUSHOLDNING
  ANNET
}

enum WeekPlanEntryType {
  RECIPE
  TAKEAWAY
  FREEZER
}

// How a person changed a day in the week plan by hand. MOVED: the meal came
// from another day; MOVED_OUT: the day was left empty because its meal moved.
enum WeekPlanChangeKind {
  ADDED
  REPLACED
  MOVED
  MOVED_OUT
  REMOVED
}

enum ShoppingViewMode {
  BY_DAY
  ALPHABETICAL
  BY_CATEGORY
}

enum ShoppingDisplayStyle {
  LIST
  GRID
}

// How far ahead of today the shopping list reaches.
enum ShoppingHorizon {
  TODAY
  THREE_DAYS
  REST_OF_WEEK
  SEVEN_DAYS
  FOURTEEN_DAYS
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum AppRole {
  USER
  ADMIN
}

// ─── Auth models (managed by better-auth) ───

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          AppRole  @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions              Session[]
  accounts              Account[]
  memberships           HouseholdMember[]
  preference            UserPreference?
  oauthCodes            OAuthAuthorizationCode[]
  oauthRefreshTokens    OAuthRefreshToken[]
  oauthPendingApprovals OAuthPendingApproval[]
  oauthClientApprovals  OAuthClientApproval[]
  weekPlanDayChanges    WeekPlanDayChange[]
}

/// Emails that are pre-approved to sign up / sign in.
/// Only listed emails (case-insensitive) may authenticate.
model AllowedEmail {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.Citext
  addedBy   String?
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ─── OAuth 2.1 authorization-server models (used by mcp-server) ───
//
// The MCP server hosts its own OAuth 2.1 + PKCE provider so that ChatGPT
// (and other MCP clients that only support OAuth) can connect to /mcp.
// User authentication is delegated to better-auth via a shared session
// cookie on the parent domain — these tables only hold the OAuth client
// registrations, short-lived authorization codes, and refresh tokens.

model OAuthClient {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @unique
  name         String?
  redirectUris String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorizationCodes OAuthAuthorizationCode[]
  refreshTokens      OAuthRefreshToken[]
  pendingApprovals   OAuthPendingApproval[]
  approvals          OAuthClientApproval[]
}

model OAuthAuthorizationCode {
  id                  String    @id @default(uuid()) @db.Uuid
  code                String    @unique
  clientId            String
  userId              String
  redirectUri         String
  scope               String?
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  clientId  String
  userId    String
  scope     String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  /// Token that replaced this one during rotation. Lets a client that
  /// never received the rotation response (dropped connection, or two
  /// refreshes racing) retry with the old token inside a short grace
  /// window and get the same replacement back instead of being logged out.
  replacedByToken String?

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

/// A consent request that has been rendered but not yet answered. Single-use:
/// the row is deleted when the user approves or denies.
model OAuthPendingApproval {
  id                  String   @id @default(uuid()) @db.Uuid
  token               String   @unique
  clientId            String
  userId              String
  redirectUri         String
  scope               String?
  state               String?
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

/// A remembered consent decision: this user has approved this client, so
/// later authorization requests skip the consent screen.
model OAuthClientApproval {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

// ─── Household models ───

model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  // Portions the household cooks for; scales recipes that state their own.
  servings  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          HouseholdMember[]
  invitations      HouseholdInvitation[]
  weekPlans        WeekPlan[]
  weekIndices      WeekIndex[]
  shoppingStates   ShoppingState[]
  extraCatalog     ExtraItemCatalog[]
  extraItems       ExtraShoppingItem[]
  shoppingDeals    ShoppingDeal[]
  dealWatchItems   DealWatchItem[]
  shoppingStores   ShoppingStore[]
  shoppingPackages ShoppingPackage[]
  freezerItems     FreezerItem[]
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @db.Uuid
  userId      String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
}

model HouseholdInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  email       String
  invitedBy   String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

// ─── User preferences (replaces device/role-based ShoppingPreference) ───

model UserPreference {
  userId                    String               @id
  defaultViewMode           ShoppingViewMode     @default(BY_DAY)
  defaultDisplayStyle       ShoppingDisplayStyle @default(LIST)
  // First weekday shown in the week planner (0 = Monday).
  startDay                  Int                  @default(0)
  shoppingHorizon           ShoppingHorizon      @default(SEVEN_DAYS)
  // Deprecated: replaced by shoppingHorizon. No longer read.
  includeNextWeek           Boolean              @default(false)
  showPantryWithIngredients Boolean              @default(false)
  compactShoppingList       Boolean              @default(false)
  plannerTapOpensRecipe     Boolean              @default(false)
  // Deprecated: days are now picked per shopping trip. No longer read.
  visibleDayIndices         Int[]                @default([0, 1, 2, 3, 4, 5, 6])
  defaultStoreId            String?              @db.Uuid
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultStore ShoppingStore? @relation(fields: [defaultStoreId], references: [id], onDelete: SetNull)
}

// ─── Shared data (global, not household-scoped) ───

model Recipe {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @unique @db.Citext
  description   String?      @db.Text
  category      MealCategory
  everydayScore Int
  healthScore   Int
  // Portions the ingredient quantities are written for.
  servings      Int?
  lastUsed      DateTime?
  usageCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  ingredients  RecipeIngredient[]
  weekEntries  WeekPlanEntry[]
  freezerItems FreezerItem[]

  @@index([category])
  @@index([lastUsed])
}

model Ingredient {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique @db.Citext
  unit         String?            @db.VarChar(32)
  isPantryItem Boolean            @default(false)
  category     IngredientCategory @default(ANNET)

  recipes      RecipeIngredient[]
  packageItems ShoppingPackageItem[]

  @@index([category])
}

model RecipeIngredient {
  recipeId     String @db.Uuid
  ingredientId String @db.Uuid

  quantity Decimal? @db.Decimal(12, 2)
  notes    String?  @db.Text

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([recipeId, ingredientId])
}

// ─── Household-scoped data ───

model WeekPlan {
  id          String   @id @default(uuid()) @db.Uuid
  weekStart   DateTime
  householdId String   @db.Uuid
  weekIndexId String?  @unique @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries    WeekPlanEntry[]
  dayChanges WeekPlanDayChange[]
  weekIndex  WeekIndex?          @relation(fields: [weekIndexId], references: [id], onDelete: Cascade)
  household  Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([weekStart, householdId])
}

model WeekIndex {
  id          String   @id @default(uuid()) @db.Uuid
  weekStart   DateTime
  householdId String   @db.Uuid
  createdAt   DateTime @default(now())

  plan      WeekPlan?
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([weekStart, householdId])
}

model WeekPlanEntry {
  id         String            @id @default(uuid()) @db.Uuid
  weekPlanId String            @db.Uuid
  dayIndex   Int
  recipeId   String?           @db.Uuid
  entryType  WeekPlanEntryType @default(RECIPE)

  weekPlan WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([weekPlanId, dayIndex])
}

// The last change a person made by hand to a day of a week plan, so the
// household can tell a deliberate choice from what the generator proposed.
// One row per day; generating a day anew removes it.
model WeekPlanDayChange {
  id            String             @id @default(uuid()) @db.Uuid
  weekPlanId    String             @db.Uuid
  dayIndex      Int
  kind          WeekPlanChangeKind
  // For MOVED the day (0 = Monday) the meal came from, for MOVED_OUT the
  // day it went to.
  otherDayIndex Int?
  changedById   String?
  changedAt     DateTime           @default(now())

  weekPlan  WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([weekPlanId, dayIndex])
}

model ShoppingState {
  id                   String   @id @default(uuid()) @db.Uuid
  weekStart            DateTime
  ingredientId         String   @db.Uuid
  unit                 String?  @db.VarChar(32)
  // True when at least one day is checked; kept in step with checkedDayIndices.
  checked              Boolean  @default(false)
  firstCheckedDayIndex Int?
  // The weekdays (0 = Monday) this item is checked off for in this week.
  checkedDayIndices    Int[]    @default([])
  householdId          String   @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([weekStart, ingredientId, unit, householdId])
  @@index([weekStart])
}

model ExtraItemCatalog {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @db.Citext
  category    IngredientCategory?
  householdId String              @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  extras       ExtraShoppingItem[]
  deal         ShoppingDeal?
  packageItems ShoppingPackageItem[]
  household    Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([name, householdId])
  @@index([category])
}

model ExtraShoppingItem {
  id            String   @id @default(uuid()) @db.Uuid
  weekStart     DateTime
  catalogItemId String   @db.Uuid
  checked       Boolean  @default(false)
  householdId   String   @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  catalogItem ExtraItemCatalog @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([weekStart, catalogItemId, householdId])
  @@index([weekStart])
}

// A store offer attached to an extra item on the shopping list. At most one
// per item: the best offer found. Expired offers are purged when the list is
// read, together with the item itself if the offer was the reason it was added.
model ShoppingDeal {
  id            String    @id @default(uuid()) @db.Uuid
  catalogItemId String    @unique @db.Uuid
  householdId   String    @db.Uuid
  store         String
  // Free text, since offers come as "39,90 kr", "2 for 70 kr", "-40 %" ...
  price         String
  regularPrice  String?
  // The concrete product on offer, e.g. "Evergood filtermalt 250 g".
  product       String?
  validFrom     DateTime? @db.Date
  // Last day the offer applies.
  validTo       DateTime  @db.Date
  // True when the offer put the item on the list (it was not there already).
  addedByDeal   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  catalogItem ExtraItemCatalog @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, validTo])
}

// Products the household wants to be told about when they are on offer.
model DealWatchItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.Citext
  // Free text: preferred brand, pack size, the price that counts as a good offer.
  note        String?
  householdId String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([name, householdId])
}

model ShoppingStore {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @db.Citext
  categoryOrder IngredientCategory[]
  isDefault     Boolean              @default(false)
  householdId   String               @db.Uuid
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  preferences UserPreference[]

  @@unique([name, householdId])
  @@index([isDefault])
}

// A shopping package groups multiple items under one name (e.g. "Pålegg" = ham, cheese, liver pâté)
model ShoppingPackage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.Citext
  householdId String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     ShoppingPackageItem[]
  household Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([name, householdId])
}

// Items belonging to a shopping package – can reference ExtraItemCatalog or Ingredient
model ShoppingPackageItem {
  id        String @id @default(uuid()) @db.Uuid
  packageId String @db.Uuid

  // At most one of these should be set (both null = free-text item)
  extraItemCatalogId String? @db.Uuid
  ingredientId       String? @db.Uuid

  // Denormalized name for display (resolved from the referenced item)
  displayName String @db.Citext

  createdAt DateTime @default(now())

  package          ShoppingPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  extraItemCatalog ExtraItemCatalog? @relation(fields: [extraItemCatalogId], references: [id], onDelete: Cascade)
  ingredient       Ingredient?       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([packageId, extraItemCatalogId])
  @@unique([packageId, ingredientId])
  @@index([packageId])
}

// Freezer inventory – tracks how many portions of a recipe are stored in the freezer
model FreezerItem {
  id          String   @id @default(uuid()) @db.Uuid
  recipeId    String   @db.Uuid
  householdId String   @db.Uuid
  quantity    Int      @default(1)
  frozenAt    DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([recipeId, householdId])
}
